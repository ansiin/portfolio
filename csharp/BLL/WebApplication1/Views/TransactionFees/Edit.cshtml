@model DAL.Entities.TransactionFee
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit TransactionFee</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class='mb-3'>
        <label asp-for='TransactionId' class='form-label'></label>
        <input asp-for='TransactionId' class='form-control' />
        <span asp-validation-for='TransactionId' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='FeeType' class='form-label'></label>
        <input asp-for='FeeType' class='form-control' />
        <span asp-validation-for='FeeType' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='Amount' class='form-label'></label>
        <input asp-for='Amount' class='form-control' />
        <span asp-validation-for='Amount' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='CurrencyId' class='form-label'></label>
        <input asp-for='CurrencyId' class='form-control' />
        <span asp-validation-for='CurrencyId' class='text-danger'></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
