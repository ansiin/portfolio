@model IReadOnlyList<App.DTO.v1.PositionSnapshots.PositionSnapshotDto>

@{
    ViewData["Title"] = UiText.T("PositionSnapshots");
    var portfolios = ViewBag.Portfolios as List<SelectListItem> ?? new List<SelectListItem>();
    var assets = ViewBag.Assets as List<SelectListItem> ?? new List<SelectListItem>();
    Guid? selectedPortfolioId = ViewBag.SelectedPortfolioId is Guid portfolioValue ? portfolioValue : null;
    Guid? selectedAssetId = ViewBag.SelectedAssetId is Guid assetValue ? assetValue : null;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">@UiText.T("PositionSnapshots")</h1>
        <p class="text-muted mb-0">@UiText.T("PositionSnapshotsLead")</p>
    </div>
    <a asp-action="Generate" asp-route-portfolioId="@selectedPortfolioId" class="btn btn-primary">@UiText.T("GenerateSnapshot")</a>
</div>

@if (TempData["Info"] is string infoMessage)
{
    <div class="alert alert-info">@infoMessage</div>
}

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label">@UiText.T("Portfolio")</label>
        <select name="portfolioId" asp-items="portfolios" class="form-select"></select>
    </div>
    <div class="col-md-5">
        <label class="form-label">@UiText.T("Asset")</label>
        <select name="assetId" asp-items="assets" class="form-select"></select>
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-outline-secondary">@UiText.T("Filter")</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        @UiText.T("NoPositionSnapshots")
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>@UiText.T("SnapshotAt")</th>
            <th>@UiText.T("Portfolio")</th>
            <th>@UiText.T("Asset")</th>
            <th>@UiText.T("Currency")</th>
            <th>@UiText.T("Quantity")</th>
            <th>@UiText.T("AverageCost")</th>
            <th>@UiText.T("LatestPrice")</th>
            <th>@UiText.T("Invested")</th>
            <th>@UiText.T("MarketValue")</th>
            <th>@UiText.T("UnrealizedPL")</th>
            <th class="text-end">@UiText.T("Actions")</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var snapshot in Model)
        {
            <tr>
                <td>@snapshot.SnapshotAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@snapshot.PortfolioName</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(snapshot.AssetName))
                    {
                        @snapshot.AssetName
                        @if (!string.IsNullOrWhiteSpace(snapshot.AssetSymbol))
                        {
                            <span class="text-muted">(@snapshot.AssetSymbol)</span>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>@(snapshot.CurrencyCode ?? "-")</td>
                <td>@snapshot.Quantity</td>
                <td>@snapshot.AverageCost</td>
                <td>@snapshot.MarketPrice</td>
                <td>@snapshot.InvestedAmount</td>
                <td>@snapshot.MarketValue</td>
                <td class="@(snapshot.UnrealizedProfit >= 0m ? "text-success" : "text-danger")">
                    @snapshot.UnrealizedProfit
                </td>
                <td class="text-end">
                    <form asp-action="Delete"
                          asp-route-id="@snapshot.Id"
                          asp-route-portfolioId="@selectedPortfolioId"
                          asp-route-assetId="@selectedAssetId"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">@UiText.T("Delete")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
