@using App.Domain.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<div class="auth-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <a class="auth-nav__user" asp-area="Identity" asp-page="/Account/Manage/Index" title="@UiText.T("Manage")">
            @UiText.T("Hello") @User.Identity?.Name
        </a>
        <div>
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="btn btn-sm btn-outline-light">@UiText.T("Logout")</button>
            </form>
        </div>
    }
    else
    {
        <a class="btn btn-sm btn-outline-light" asp-area="Identity" asp-page="/Account/Register">@UiText.T("Register")</a>
        <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Login">@UiText.T("Login")</a>
    }
</div>
