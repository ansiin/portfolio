@model WebApp.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = UiText.T("ErrorTitle");
}

<h1 class="text-danger">@UiText.T("ErrorTitle")</h1>
<h2 class="text-danger">@UiText.T("ErrorLead")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@UiText.T("RequestId"):</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@UiText.T("DevelopmentMode")</h3>
<p>
    @UiText.T("DevelopmentModeLead")
</p>
<p>
    @UiText.T("DevelopmentModeWarning")
</p>
