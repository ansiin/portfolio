@model IReadOnlyList<App.DTO.v1.Watchlists.WatchlistDto>

@{
    ViewData["Title"] = UiText.T("Watchlists");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">@UiText.T("Watchlists")</h1>
        <p class="text-muted mb-0">@UiText.T("WatchlistsLead")</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">@UiText.T("CreateWatchlist")</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        @UiText.T("NoWatchlists")
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>@UiText.T("Name")</th>
            <th>@UiText.T("Items")</th>
            <th>@UiText.T("Assets")</th>
            <th class="text-end">@UiText.T("Actions")</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var watchlist in Model)
        {
            <tr>
                <td>@watchlist.Name</td>
                <td>@watchlist.ItemCount</td>
                <td>
                    @if (watchlist.Items.Count == 0)
                    {
                        <span class="text-muted">@UiText.T("NoLinkedAssets")</span>
                    }
                    else
                    {
                        @string.Join(", ", watchlist.Items.Select(item => item.AssetSymbol is { Length: > 0 } ? $"{item.AssetName} ({item.AssetSymbol})" : item.AssetName))
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@watchlist.Id" class="btn btn-sm btn-outline-primary">@UiText.T("Edit")</a>
                    <form asp-action="Delete" asp-route-id="@watchlist.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">@UiText.T("Delete")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
