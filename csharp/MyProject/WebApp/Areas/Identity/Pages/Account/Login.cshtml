@page
@model WebApp.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = UiText.T("Login");
}

<section class="auth-shell">
    <div class="auth-shell__panel auth-shell__panel--intro">
        <span class="eyebrow">@UiText.T("AppTitle")</span>
        <h1 class="auth-title">@UiText.T("Login")</h1>
        <p class="auth-copy">@UiText.T("LoginLead")</p>

        <div class="auth-highlight">
            <strong>@UiText.T("DemoCredentials")</strong>
            <span>user@taltech.ee</span>
            <span>Kala.12345</span>
        </div>

        <div class="auth-bullets">
            <div>@UiText.T("FeatureOneLead")</div>
            <div>@UiText.T("FeatureTwoLead")</div>
            <div>@UiText.T("FeatureThreeLead")</div>
        </div>
    </div>

    <div class="auth-shell__panel auth-shell__panel--form">
        <div class="auth-card">
            <div class="mb-4">
                <h2 class="section-title mb-2">@UiText.T("Login")</h2>
                <p class="text-muted mb-0">@UiText.T("AuthFormLead")</p>
            </div>

            <form method="post" class="d-grid gap-3">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <input asp-for="ReturnUrl" type="hidden"/>

                <div>
                    <label asp-for="Input.Email" class="form-label">@UiText.T("Email")</label>
                    <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username"/>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="form-label">@UiText.T("Password")</label>
                    <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password"/>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input"/>
                    <label asp-for="Input.RememberMe" class="form-check-label">@UiText.T("RememberMe")</label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">@UiText.T("Login")</button>
            </form>

            <hr class="my-4"/>

            <div class="text-center d-grid gap-2">
                <p class="text-muted mb-1">@UiText.T("NeedAccount")</p>
                <a class="btn btn-outline-secondary"
                   asp-area="Identity"
                   asp-page="/Account/Register"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    @UiText.T("CreateAccount")
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
