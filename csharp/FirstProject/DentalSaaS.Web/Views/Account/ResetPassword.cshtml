@model DentalSaaS.Web.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<section class="card fade-item" style="max-width: 640px;">
    <h1 class="page-title">Reset password</h1>
    <p class="page-subtitle">Set a new password for your account.</p>

    <form method="post" class="form" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Password" class="label"></label>
                <input asp-for="Password" />
                <span asp-validation-for="Password"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword" class="label"></label>
                <input asp-for="ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>

        <div class="btn-group">
            <button type="submit" class="btn btn-primary">Reset password</button>
            <a class="btn btn-secondary" href="/account/login">Back to login</a>
        </div>
    </form>

    <div class="validation" asp-validation-summary="All"></div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
