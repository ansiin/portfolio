@model DentalSaaS.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="card fade-item" style="max-width: 560px;">
    <h1 class="page-title">Forgot password</h1>
    <p class="page-subtitle">Generate a password reset link for your account.</p>

    <form method="post" class="form" novalidate>
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="Email" class="label"></label>
            <input asp-for="Email" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="btn-group">
            <button type="submit" class="btn btn-primary">Generate link</button>
            <a class="btn btn-secondary" href="/account/login">Back to login</a>
        </div>
    </form>

    <div class="validation" asp-validation-summary="All"></div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
