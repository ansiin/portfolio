@model DentalSaaS.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="page-header fade-item">
    <h1 class="page-title">Create account</h1>
    <p class="page-subtitle">Create a user account for system access and tenant memberships.</p>
</div>

<section class="card fade-item" style="max-width: 640px;">
    <form method="post" class="form" novalidate>
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Email" class="label"></label>
            <input asp-for="Email" />
            <span asp-validation-for="Email"></span>
        </div>

        <div class="form-group">
            <label asp-for="DisplayName" class="label"></label>
            <input asp-for="DisplayName" />
            <span asp-validation-for="DisplayName"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Password" class="label"></label>
                <input asp-for="Password" />
                <span asp-validation-for="Password"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword" class="label"></label>
                <input asp-for="ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>

        <div class="btn-group">
            <button type="submit" class="btn btn-primary">Register</button>
            <a class="btn btn-secondary" href="/account/login">Back to login</a>
        </div>
    </form>

    <div class="validation" asp-validation-summary="All"></div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
