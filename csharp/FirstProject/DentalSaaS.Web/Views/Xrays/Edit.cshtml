@model DentalSaaS.Web.ViewModels.Xrays.XrayFormViewModel
@using DentalSaaS.Application.Patients
@{
    var tenantSlug = (string)ViewBag.TenantSlug;
    var patientOptions = (IReadOnlyCollection<PatientListItem>?)ViewBag.PatientOptions ?? Array.Empty<PatientListItem>();
    ViewData["Title"] = "Edit X-ray";
}

<section class="card fade-item">
    <h1 class="page-title">Edit X-ray</h1>
    <form method="post" action="/@tenantSlug/xrays/edit/@Model.Id" class="form">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label class="label" for="PatientId">Patient</label>
            <select asp-for="PatientId" disabled>
                @foreach (var patient in patientOptions)
                {
                    <option value="@patient.Id">@patient.FullName (@patient.Email)</option>
                }
            </select>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="TakenAt" class="label"></label>
                <input asp-for="TakenAt" />
            </div>
            <div class="form-group">
                <label asp-for="FileUrl" class="label"></label>
                <input asp-for="FileUrl" />
            </div>
        </div>
        <div class="btn-group">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-secondary" href="/@tenantSlug/xrays">Cancel</a>
        </div>
    </form>
    <div asp-validation-summary="All" class="validation"></div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
