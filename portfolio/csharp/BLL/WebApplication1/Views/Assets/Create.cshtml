@model DAL.Entities.Asset
@{
    ViewData["Title"] = "Create";
}

<h1>Create Asset</h1>

<form asp-action="Create" method="post">
    <div class='mb-3'>
        <label asp-for='AssetTypeId' class='form-label'></label>
        <input asp-for='AssetTypeId' class='form-control' />
        <span asp-validation-for='AssetTypeId' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='ExchangeId' class='form-label'></label>
        <input asp-for='ExchangeId' class='form-control' />
        <span asp-validation-for='ExchangeId' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='CurrencyId' class='form-label'></label>
        <input asp-for='CurrencyId' class='form-control' />
        <span asp-validation-for='CurrencyId' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='Symbol' class='form-label'></label>
        <input asp-for='Symbol' class='form-control' />
        <span asp-validation-for='Symbol' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='Name' class='form-label'></label>
        <input asp-for='Name' class='form-control' />
        <span asp-validation-for='Name' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='SteamMarketHashName' class='form-label'></label>
        <input asp-for='SteamMarketHashName' class='form-control' />
        <span asp-validation-for='SteamMarketHashName' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='ExternalId' class='form-label'></label>
        <input asp-for='ExternalId' class='form-control' />
        <span asp-validation-for='ExternalId' class='text-danger'></span>
    </div>
    <div class='form-check mb-3'>
        <input asp-for='IsActive' class='form-check-input' />
        <label asp-for='IsActive' class='form-check-label'></label>
    </div>
    <div class='mb-3'>
        <label asp-for='CreatedAt' class='form-label'></label>
        <input asp-for='CreatedAt' class='form-control' />
        <span asp-validation-for='CreatedAt' class='text-danger'></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
