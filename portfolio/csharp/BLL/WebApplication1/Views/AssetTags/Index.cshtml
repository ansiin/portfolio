@model IEnumerable<DAL.Entities.AssetTag>
@{
    ViewData["Title"] = "AssetTags";
}

<h1>AssetTags</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.AssetId)</th>
            <th>@Html.DisplayNameFor(model => model.TagId)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.AssetId)</td>
            <td>@Html.DisplayFor(modelItem => item.TagId)</td>
            <td>
                <a asp-action="Edit" asp-route-AssetId="@item.AssetId" asp-route-TagId="@item.TagId">Edit</a> |
                <a asp-action="Details" asp-route-AssetId="@item.AssetId" asp-route-TagId="@item.TagId">Details</a> |
                <a asp-action="Delete" asp-route-AssetId="@item.AssetId" asp-route-TagId="@item.TagId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
