@model IEnumerable<DAL.Entities.PositionSnapshot>
@{
    ViewData["Title"] = "PositionSnapshots";
}

<h1>PositionSnapshots</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.PortfolioId)</th>
            <th>@Html.DisplayNameFor(model => model.AssetId)</th>
            <th>@Html.DisplayNameFor(model => model.Month)</th>
            <th>@Html.DisplayNameFor(model => model.Quantity)</th>
            <th>@Html.DisplayNameFor(model => model.AvgCost)</th>
            <th>@Html.DisplayNameFor(model => model.CostCurrencyId)</th>
            <th>@Html.DisplayNameFor(model => model.MarketPrice)</th>
            <th>@Html.DisplayNameFor(model => model.MarketCurrencyId)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Id)</td>
            <td>@Html.DisplayFor(modelItem => item.PortfolioId)</td>
            <td>@Html.DisplayFor(modelItem => item.AssetId)</td>
            <td>@Html.DisplayFor(modelItem => item.Month)</td>
            <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
            <td>@Html.DisplayFor(modelItem => item.AvgCost)</td>
            <td>@Html.DisplayFor(modelItem => item.CostCurrencyId)</td>
            <td>@Html.DisplayFor(modelItem => item.MarketPrice)</td>
            <td>@Html.DisplayFor(modelItem => item.MarketCurrencyId)</td>
            <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
