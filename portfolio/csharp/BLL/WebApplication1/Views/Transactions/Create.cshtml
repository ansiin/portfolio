@model DAL.Entities.Transaction
@{
    ViewData["Title"] = "Create";
}

<h1>Create Transaction</h1>

<form asp-action="Create" method="post">
    <div class='mb-3'>
        <label asp-for='PortfolioId' class='form-label'></label>
        <input asp-for='PortfolioId' class='form-control' />
        <span asp-validation-for='PortfolioId' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='AssetId' class='form-label'></label>
        <input asp-for='AssetId' class='form-control' />
        <span asp-validation-for='AssetId' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='TradeTime' class='form-label'></label>
        <input asp-for='TradeTime' class='form-control' />
        <span asp-validation-for='TradeTime' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='Quantity' class='form-label'></label>
        <input asp-for='Quantity' class='form-control' />
        <span asp-validation-for='Quantity' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='UnitPrice' class='form-label'></label>
        <input asp-for='UnitPrice' class='form-control' />
        <span asp-validation-for='UnitPrice' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='CurrencyId' class='form-label'></label>
        <input asp-for='CurrencyId' class='form-control' />
        <span asp-validation-for='CurrencyId' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='CashAmount' class='form-label'></label>
        <input asp-for='CashAmount' class='form-control' />
        <span asp-validation-for='CashAmount' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='Note' class='form-label'></label>
        <input asp-for='Note' class='form-control' />
        <span asp-validation-for='Note' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='CreatedAt' class='form-label'></label>
        <input asp-for='CreatedAt' class='form-control' />
        <span asp-validation-for='CreatedAt' class='text-danger'></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
