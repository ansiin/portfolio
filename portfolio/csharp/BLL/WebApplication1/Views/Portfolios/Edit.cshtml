@model DAL.Entities.Portfolio
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Portfolio</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class='mb-3'>
        <label asp-for='AppUserId' class='form-label'></label>
        <input asp-for='AppUserId' class='form-control' />
        <span asp-validation-for='AppUserId' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='Name' class='form-label'></label>
        <input asp-for='Name' class='form-control' />
        <span asp-validation-for='Name' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='BaseCurrencyId' class='form-label'></label>
        <input asp-for='BaseCurrencyId' class='form-control' />
        <span asp-validation-for='BaseCurrencyId' class='text-danger'></span>
    </div>
    <div class='mb-3'>
        <label asp-for='CreatedAt' class='form-label'></label>
        <input asp-for='CreatedAt' class='form-control' />
        <span asp-validation-for='CreatedAt' class='text-danger'></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
