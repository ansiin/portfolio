@using DentalSaaS.Shared.Enums
@model IReadOnlyCollection<DentalSaaS.Application.Abstractions.SystemSubscriptionItem>
@{
    ViewData["Title"] = "Billing";
    var companies = (IReadOnlyCollection<DentalSaaS.Application.Abstractions.SystemCompanyItem>)ViewBag.Companies;
}

<div class="page-header fade-item">
    <h1 class="page-title">Billing</h1>
    <p class="page-subtitle">Manage subscription tiers and billing state across tenants.</p>
</div>

<section class="card fade-item">
    <h2 class="card-title">Change subscription tier</h2>
    <form method="post" action="/system/billing/tier" class="form">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <div class="form-group">
                <label class="label" for="companyId">Company</label>
                <select id="companyId" name="companyId">
                    @foreach (var company in companies)
                    {
                        <option value="@company.CompanyId">@company.Name (@company.Slug)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="label" for="tier">Tier</label>
                <select id="tier" name="tier">
                    <option value="@SubscriptionTier.Free">Free</option>
                    <option value="@SubscriptionTier.Standard">Standard</option>
                    <option value="@SubscriptionTier.Premium">Premium</option>
                </select>
            </div>
        </div>
        <div class="btn-group">
            <button type="submit" class="btn btn-primary">Update tier</button>
        </div>
    </form>
</section>

<section class="card fade-item">
    <h2 class="card-title">Subscription history</h2>
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th>Company</th>
                <th>Tier</th>
                <th>Valid From</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CompanySlug</td>
                    <td>@item.Tier</td>
                    <td>@item.ValidFrom</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
