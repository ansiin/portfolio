@model IReadOnlyList<App.DTO.v1.Assets.AssetDto>

@{
    ViewData["Title"] = UiText.T("Assets");
    var portfolios = ViewBag.Portfolios as List<SelectListItem> ?? new List<SelectListItem>();
    Guid? selectedPortfolioId = ViewBag.SelectedPortfolioId is Guid value ? value : null;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">@UiText.T("Assets")</h1>
        <p class="text-muted mb-0">@UiText.T("AssetsLead")</p>
    </div>
    <a asp-action="Create" asp-route-portfolioId="@selectedPortfolioId" class="btn btn-primary">@UiText.T("CreateAsset")</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label">@UiText.T("PortfolioFilter")</label>
        <select name="portfolioId" asp-items="portfolios" class="form-select"></select>
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-outline-secondary">@UiText.T("Filter")</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        @UiText.T("NoAssets")
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>@UiText.T("Name")</th>
            <th>@UiText.T("Portfolio")</th>
            <th>@UiText.T("Type")</th>
            <th>@UiText.T("Currency")</th>
            <th>@UiText.T("Status")</th>
            <th class="text-end">@UiText.T("Actions")</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var asset in Model)
        {
            <tr>
                <td>
                    <div>@asset.Name</div>
                    @if (!string.IsNullOrWhiteSpace(asset.Symbol))
                    {
                        <small class="text-muted">@asset.Symbol</small>
                    }
                </td>
                <td>@asset.PortfolioName</td>
                <td>@asset.AssetTypeCode</td>
                <td>@asset.CurrencyCode</td>
                <td>
                    @if (asset.IsActive)
                    {
                        <span class="badge text-bg-success">@UiText.T("Active")</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">@UiText.T("Inactive")</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-primary">@UiText.T("Edit")</a>
                    <form asp-action="Delete" asp-route-id="@asset.Id" asp-route-portfolioId="@selectedPortfolioId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">@UiText.T("Deactivate")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
